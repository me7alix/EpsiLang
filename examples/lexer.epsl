fn lexer_new(str) {
	return {
		.char_stream = str,
		.cur_tok = 0,
	};
}

fn lexer_chp(l) {
	if l.cur_tok >= len(l.char_stream) => '\0';
	return l.char_stream[l.cur_tok];
}

fn lexer_chn(l) {
	s := lexer_chp(l);
	l.cur_tok += 1;
	return s;
}

fn lexer_chp2(l) {
	saved := l.cur_tok;
	lexer_chn(l);
	ch := lexer_chp(l);
	l.cur_tok = saved;
	return ch;
}

fn token(kind, data) {
	return {
		.kind = kind,
		.data = data,
	};
}

fn is_digit(ch) =>
	ch >= '0' and ch <= '9';

fn is_ident(ch) =>
	ch == '_' or (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z');

fn lexer_next(l) {
	ch := lexer_chp(l);
	res := none;

	if ch == ' ' {
		lexer_chn(l);
		return lexer_next(l);
	}

	else if ch == '\0' do res = token(.EOF,   "");
	else if ch == '+'  do res = token(.PLUS,  "+");
	else if ch == '-'  do res = token(.MINUS, "-");
	else if ch == '*'  do res = token(.STAR,  "*");
	else if ch == '/'  do res = token(.SLASH, "/");

	else if is_digit(ch) {
		digits := "";
		while is_digit(lexer_chp(l)) do
			append(digits, lexer_chn(l));
		return token(.INT, int(digits));
	} else if is_ident(ch) {
		ident := "";
		while is_ident(lexer_chp(l)) do
			append(ident, lexer_chn(l));
		return token(.IDENT, ident);
	}

	lexer_chn(l);
	return res;
}

fn lexer_peek(l) {
	saved := l.cur_tok;
	tok := lexer_next(l);
	l.cur_tok = saved;
	return tok;
}

fn lexer_peek2(l) {
	saved := l.cur_tok;
	lexer_next(l);
	tok := lexer_next(l);
	l.cur_tok = saved;
	return tok;
}

lex := lexer_new(input("Enter expression: "));
while lexer_peek(lex).kind != .EOF do
	println(lexer_next(lex));
