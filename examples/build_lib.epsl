build_debug_mode := has(_OS_ARGS_, "-debug");
import "examples/build.epsl";

if len(_OS_ARGS_) > 0 {
	if _OS_ARGS_[0] == "help" {
		println("Options:");
		println("  debug     Enable debug mode");

		println("");
		println("Commands:");
		println("  (none)    Build the library");
		println("  install   Build and install the library");
		println("  help      Show this message");
		exit(0);
	}
}

build_folder := path("build", "epsilang");
output_file := path(build_folder, "lib", "libepsl");

srcs := [
	path("src", "api.c"),
	path("src", "print.c"),
	path("src", "lexer.c"),
	path("src", "parser.c"),
	path("src", "eval.c"),
	path("src", "stdlib.c"),
	path("src", "utils.c"),
];

make_dir("build");
make_dir(build_folder);
make_dir(path(build_folder, "include"));
make_dir(path(build_folder, "lib"));

epsl_api := path(build_folder, "include", "epsl_api.h");
copy_file(path("include", "api.h"), epsl_api);

cmd(
	"cc",
	"-fPIC",
	"-shared",
	"-std=c99",
	"-O3",
	"-o", dynamic_lib(output_file),
	join(srcs)
);

cmd(
	"cc",
	"-c",
	"-std=c99",
	"-O3",
	join(srcs)
);

cmd("ar rcs", static_lib(output_file), "*.o");

remove_file("*.o");

if len(_OS_ARGS_) > 0 {
	if _OS_ARGS_[0] == "install" {
		if _OS_ == "LINUX" or _OS_ == "APPLE" {
			copy_file(dynamic_lib(output_file), "/usr/local/lib");
			copy_file(static_lib(output_file), "/usr/local/lib");
			copy_file(epsl_api, "/usr/local/include");
		} else {
			if input("Do you use MSYS2 and is it located in the default path? (yes/no): ") == "yes" {
				copy_file(dynamic_lib(output_file), "C:\\msys64\\mingw64\\bin");
				copy_file(static_lib(output_file), "C:\\msys64\\mingw64\\lib");
				copy_file(epsl_api, "C:\\msys64\\mingw64\\include");
			}
		}
	}
}
