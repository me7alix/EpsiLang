println("max(2, 3) = ", max(2, 3));
println("max(2, 3) = ", max(2, 3.0));
println("max(2.0, 3) = ", max(2.0, 3));
println("max(2.0, 3.0) = ", max(2.0, 3.0));
println("min(2.0, 3) = ", min(2.0, 3));
println("floor(7.3) = ", floor(7.3));
println("ceil(7.3) = ", ceil(7.3));
println("sqrt(9.0) = ", sqrt(9.0));
println("cos(0.0) = ", cos(0.0));
println("sin(0.0) = ", sin(0.0));
