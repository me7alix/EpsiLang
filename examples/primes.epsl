region := 300000;
found  := 0;

fn is_prime(n) {
	if n == 1 or n == 2 => true;
	until := sqrt(n);
	for i := 2; i <= until; i+=1 do
		if n % i == 0 => false;
	return true;
}

for i := 1; i <= region; i+=1 {
	if is_prime(i) do found += 1;
	if i % 25000 == 0 do println("[1, ", i, "]: ", found / i, "% primes");
}
